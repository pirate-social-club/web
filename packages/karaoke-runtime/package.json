{
  "name": "@pirate-social-club/karaoke-runtime",
  "version": "0.2.2",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirate-social-club/web.git",
    "directory": "packages/karaoke-runtime"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/provenance.ts",
      "default": "./src/provenance.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "files": [
    "src",
    "build-info.json",
    "SPEC.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:provenance": "bun run scripts/build-provenance.ts",
    "prepack": "bun run scripts/build-provenance.ts",
    "types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun run scripts/build-provenance.ts && bun test tests/",
    "lint:imports": "bun run scripts/check-forbidden-imports.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2"
  }
}
