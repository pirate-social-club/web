{
  "name": "@pirate/web",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "postinstall": "bun run scripts/build-provenance.ts generate --allow-placeholder",
    "build:provenance": "bun run scripts/build-provenance.ts",
    "build:provenance:emit": "bun run scripts/build-provenance.ts emit-dist",
    "build:service-worker": "bun run scripts/stamp-service-worker.ts",
    "locales:generate": "node ./scripts/generate-locales.mjs",
    "env:check:prod": "node ./scripts/check-vite-env.mjs production VITE_PRIVY_APP_ID VITE_PRIVY_CLIENT_ID",
    "env:check:staging": "node ./scripts/check-vite-env.mjs staging VITE_PRIVY_APP_ID",
    "dev": "bun run locales:generate && bun run worklet:build && vite --host :: --port 5173 --strictPort",
    "xmtp:dev:receive": "bun run ./scripts/xmtp-dev-receiver.ts",
    "xmtp:dev:send": "bun run ./scripts/xmtp-dev-send.ts",
    "dev:desktop-shell": "bun run locales:generate && bun run worklet:build && vite --config vite.desktop.config.ts",
    "dev:init": "rw-scripts dev-init",
    "build": "bun run locales:generate && bun run worklet:build && vite build",
    "build:prod": "bun run build:provenance && bun run env:check:prod && bun run build -- --mode production --minify false --sourcemap false && bun run build:service-worker && bun run build:provenance:emit",
    "build:staging": "bun run build:provenance && VITE_PRIVY_CLIENT_ID= bun run env:check:staging && VITE_PRIVY_CLIENT_ID= bun run build -- --mode staging --minify false --sourcemap false && bun run build:service-worker && bun run build:provenance:emit",
    "build:desktop-shell": "bun run locales:generate && bun run worklet:build && vite build --config vite.desktop.config.ts",
    "preview": "bun run locales:generate && bun run worklet:build && vite preview",
    "worklet:build": "node ./scripts/build-karaoke-worklet.mjs",
    "storybook": "bun run locales:generate && storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "bun run locales:generate && storybook build",
    "worker:run": "bun run locales:generate && rw-scripts worker-run",
    "generate": "bun run locales:generate && wrangler types --include-runtime false",
    "deploy:main": "scripts/deploy-production.sh --confirm-production --skip-tests",
    "deploy:main:staging": "scripts/deploy-staging.sh",
    "deploy:public": "scripts/deploy-public.sh --env production --confirm-production",
    "deploy:public:staging": "scripts/deploy-public.sh --env staging",
    "test": "bun test --isolate src packages scripts --timeout=15000",
    "test:assistant:light": "bun test src/lib/chat/community-assistant-chat-client.test.ts src/lib/chat/chat-conversation-state.test.ts src/components/compositions/chat/chat-route-views.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:required-gate": "node scripts/run-required-playwright-gate.mjs",
    "test:e2e:assistant:ui": "playwright test e2e/community-assistant-chat-ui.spec.ts --project=chromium",
    "test:e2e:assistant:local": "playwright test e2e/community-assistant.local.spec.ts",
    "test:e2e:staging": "E2E_BASE_URL=https://staging.pirate.sc playwright test",
    "test:e2e:live-staging": "E2E_LIVE_STAGING=true E2E_BASE_URL=https://staging.pirate.sc E2E_API_BASE_URL=https://api-staging.pirate.sc playwright test --project=live-staging",
    "test:e2e:staging-provisioning:manual": "bun run scripts/manual-staging-community-provisioning.ts",
    "test:zkpassport:staging": "bun run scripts/live-zkpassport-staging-smoke.ts",
    "test:e2e:story-derivative-royalty": "bun run scripts/live-story-derivative-royalty-e2e.ts",
    "boundary:audit": "node ./scripts/boundary-audit.mjs",
    "lint:hooks": "eslint src packages --max-warnings 0",
    "deadcode:audit": "NODE_OPTIONS=--max-old-space-size=8192 knip --no-progress",
    "deps:audit": "knip --dependencies --no-progress",
    "agents:openclaw:challenge": "node ./scripts/build-openclaw-challenge.mjs",
    "ui:audit": "node ./scripts/ui-audit.mjs",
    "size:ratchet": "node ./scripts/check-frontend-size-ratchet.mjs",
    "validate": "bun run locales:generate && bun run types && bun run boundary:audit && bun run test && bun run ui:audit",
    "types": "bun run locales:generate && tsgo --noEmit -p tsconfig.app.json",
    "types:stories": "tsgo --noEmit -p tsconfig.stories.json",
    "types:tests": "tsgo --noEmit -p tsconfig.tests.json",
    "types:safe": "bun run locales:generate && node ./scripts/run-types-safely.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fontsource/anton": "^5.2.7",
    "@noble/hashes": "^2.2.0",
    "@pirate-social-club/karaoke-runtime": "file:./packages/karaoke-runtime",
    "@pirate/api-contracts": "file:../api/services/contracts",
    "@pirate/bookings-domain": "file:./packages/bookings-domain",
    "@privy-io/react-auth": "^3.33.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@selfxyz/qrcode": "^1.0.24",
    "@selfxyz/sdk-common": "^1.0.0",
    "@sentry/react": "^10.62.0",
    "@story-protocol/core-sdk": "^1.4.4",
    "@tanstack/react-query": "^5.100.9",
    "@veryai/widget": "^1.0.22",
    "@vidstack/react": "^1.12.13",
    "@web3icons/react": "^4.1.17",
    "@xmtp/browser-sdk": "^7.0.0",
    "@zkpassport/sdk": "^0.14.2",
    "agora-rtc-sdk-ng": "^4.24.3",
    "altcha": "^3.0.8",
    "altcha-lib": "2.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-circle-flags": "^0.0.29",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "^1.3.0-canary.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "viem": "^2.48.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@cloudflare/workers-types": "4.20260307.1",
    "@noble/curves": "^2.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "@playwright/test": "^1.60.0",
    "@storybook/react": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "^25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.59.2",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@xmtp/node-sdk": "^6.0.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "^13.0.6",
    "knip": "^6.14.2",
    "linkedom": "^0.18.12",
    "qrcode": "^1.5.4",
    "storybook": "10.5.3",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "undici": "^8.5.0",
    "vite": "^8.0.16",
    "wrangler": "4.81.1"
  },
  "overrides": {
    "axios": "^1.18.0",
    "brace-expansion": "5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri": "^4.1.2",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "ip-address": "^10.4.0",
    "js-cookie": "^3.0.7",
    "postcss": "8.5.26",
    "tmp": "^0.2.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "^0.35.3",
    "socket.io-parser": "^4.2.7",
    "vite": "^8.0.16",
    "ws": "^8.21.0",
    "undici": "^8.10.0"
  }
}
