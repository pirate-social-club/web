{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    "worktrees/**",
    "src/lib/auth/privy-react-auth.ssr.tsx",
    "src/lib/dotenv-browser-shim.ts",
    "src/lib/rwsdk-router.client.ts",
    "src/lib/rwsdk-worker.client.ts",
    "src/vendor/**"
  ],
  "ignoreBinaries": [
    "scripts/community/repair-community-migration-ledger.ts",
    "scripts/control-plane/apply-postgres-migrations.ts",
    "scripts/deploy-production.sh",
    "scripts/deploy-public.sh",
    "scripts/deploy-staging.sh"
  ],
  "ignoreDependencies": [
    "@fontsource/anton",
    "tailwindcss",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "vite.config.ts",
        "vite.desktop.config.ts",
        "src/worker-public.ts",
        "src/client.tsx",
        "src/desktop-standalone.tsx",
        "src/components/compositions/karaoke/capture/karaoke-capture-processor.ts",
        "e2e/**/*.spec.ts",
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        ".storybook/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts}",
        "src/**/*.{ts,tsx,js,jsx}"
      ],
      "vite": false
    },
    "packages/bookings-domain": {
      "entry": ["src/index.ts", "src/test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/karaoke-runtime": {
      "entry": ["src/index.ts", "src/provenance.ts", "src/test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
