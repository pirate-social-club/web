{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pirate-web-public",
  "main": "src/worker-public.ts",
  "workers_dev": true,
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEPLOY_ENV": "production",
    "NODE_ENV": "production",
    "HNS_PUBLIC_API_ORIGIN": "https://api.pirate.sc",
    "HNS_PUBLIC_APP_ORIGIN": "https://pirate.sc"
  },
  "routes": [],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "staging": {
      "name": "pirate-web-public-staging",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "DEPLOY_ENV": "staging",
        "NODE_ENV": "production",
        "HNS_PUBLIC_API_ORIGIN": "https://api-staging.pirate.sc",
        "HNS_PUBLIC_APP_ORIGIN": "https://staging.pirate.sc"
      },
      "routes": []
    }
  }
}
