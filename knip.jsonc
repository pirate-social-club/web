{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    "src/lib/auth/privy-react-auth.ssr.tsx",
    "src/lib/dotenv-browser-shim.ts",
    "src/lib/rwsdk-router.client.ts",
    "src/lib/rwsdk-worker.client.ts",
    "src/vendor/**"
  ],
  "ignoreBinaries": [
    "core/scripts/community/apply-commerce-integer-money-d1-migration.ts",
    "core/scripts/community/apply-listings-asset-unique-index-d1-migration.ts",
    "core/scripts/community/apply-generic-assets-learning-foundation-d1-migration.ts",
    "core/scripts/community/repair-staging-1158-source-columns.ts",
    "core/scripts/community/apply-song-study-fill-blank-d1-migration.ts",
    "core/scripts/community/apply-lyrics-language-d1-migration.ts",
    "core/scripts/community/apply-song-study-orchestration-v2-d1-migration.ts",
    "core/scripts/community/apply-user-account-merge-receipts-d1-migration.ts",
    "core/scripts/community/apply-dance-start-cue-evidence-d1-migration.ts",
    "core/scripts/community/apply-post-age-gate-provenance-d1-migration.ts",
    "core/scripts/community/apply-community-handle-claim-intents-d1-migration.ts",
    "core/scripts/community/repair-community-handle-claim-intents-d1.ts",
    "core/scripts/community/verify-community-schema-requirements.ts",
    "scripts/control-plane/verify-generic-story-asset-kinds.ts",
    "scripts/control-plane/audit-provider-identity-evidence.ts",
    "scripts/control-plane/provider-identity-invalid-link-audit-once.ts",
    "scripts/control-plane/provider-identity-duplicate-evidence-provenance-once.ts",
    "web/scripts/song-study-fill-blank-row-counts.ts",
    "scripts/control-plane/inspect-control-plane-migration-ledger.ts",
    "scripts/control-plane/apply-postgres-migrations.ts",
    "scripts/deploy-production.sh",
    "scripts/deploy-public.sh",
    "scripts/deploy-staging.sh"
  ],
  "ignoreDependencies": [
    // These are resolved from nested Solid sources/configs while the root audit
    // runs from the Web package; keep the root install explicit for CI.
    "@pirate/api-client",
    "@fontsource/anton",
    "remark-gfm",
    "tailwindcss",
    "tw-animate-css",
    "vitest"
  ],
  "ignoreIssues": {
    // Mock modules expose reusable fixture types even when the app does not import every type.
    "src/app/mocks/types.ts": ["types"],
    // Accepted Solid migration modules expose composition contracts before every
    // product route consumes them. Keep this baseline file-specific so it can
    // shrink as cutover routes replace Storybook-only consumers.
    "solid/src/features/bookings/add-to-calendar/add-to-calendar.tsx": ["exports"],
    "solid/src/features/bookings/add-to-calendar/calendar-file.ts": ["exports"],
    "solid/src/features/bookings/booking-cancellation-dialog/booking-cancellation-dialog.tsx": ["types"],
    "solid/src/features/bookings/profile-bookings-section/profile-bookings-section-model.ts": ["exports"],
    "solid/src/features/bookings/profile-bookings-section/profile-bookings-section.tsx": ["types"],
    "solid/src/features/bookings/slot-picker/slot-picker.tsx": ["exports", "types"],
    "solid/src/features/bookings/view-models.ts": ["types"],
    "solid/src/features/community/archive-page/community-archive-page.tsx": ["types"],
    "solid/src/features/community/links-editor/community-links-editor-page.tsx": ["exports", "types"],
    "solid/src/features/community/membership-requests-page/membership-requests-page-model.ts": ["types"],
    "solid/src/features/community/rules-editor/community-rules-editor-page.tsx": ["exports"],
    "solid/src/features/community/your-communities-page/your-communities-page.tsx": ["duplicates"],
    "solid/src/features/posts/feed-side-panel/feed-side-panel-model.ts": ["exports"],
    "solid/src/features/posts/feed-side-panel/feed-side-panel.tsx": ["exports"],
    "solid/src/features/posts/video-feed/video-feed.tsx": ["types"],
    "solid/src/features/posts/video-feed/video-feed.types.ts": ["types"],
    "solid/src/features/profiles/edit-profile-form/edit-profile-form.model.ts": ["exports"],
    "solid/src/features/profiles/edit-profile-form/edit-profile-form.tsx": ["exports"],
    "solid/src/features/profiles/edit-profile-form/edit-profile-form.types.ts": ["types"],
    "solid/src/features/profiles/profile-page/profile-page-fixtures.ts": ["exports"],
    "solid/src/features/profiles/profile-page/profile-page.model.ts": ["exports"],
    "solid/src/features/profiles/profile-page/profile-page.types.ts": ["types"],
    "solid/src/features/wallet/wallet-hub.types.ts": ["types"],
    "solid/src/features/wallet/wallet-receive-sheet-model.ts": ["exports"],
    "solid/src/features/wallet/wallet-receive-sheet.tsx": ["exports"],
    "solid/src/features/wallet/wallet-send-sheet.types.ts": ["types"],
    "solid/src/lib/api/public-profile.ts": ["exports", "types"],
    "solid/src/lib/public-profile-presentation.ts": ["exports"],
    // These exports are intentional public/compatibility seams for external consumers and
    // routes that have not migrated to the create-style accessors yet.
    "packages/solid-ui/src/patterns/navigation/sidebar/index.ts": ["exports"],
    "solid/src/lib/breakpoints.ts": ["exports"],
    "solid/src/lib/host-context.tsx": ["exports", "types", "duplicates"],
    "solid/src/lib/media-query.ts": ["exports"],
    "solid/src/lib/public-video-feed-session.ts": ["exports", "types"],
    "solid/src/lib/ui-locale.tsx": ["exports", "types", "duplicates"],
    "solid/src/lib/api/origin.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "vite.config.ts",
        "src/worker-public.ts",
        "src/client.tsx",
        "src/desktop-standalone.tsx",
        "src/components/compositions/karaoke/capture/karaoke-capture-processor.ts",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.spec.ts",
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        ".storybook/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts}",
        "src/**/*.{ts,tsx,js,jsx}"
      ],
      "vite": false
    },
    "packages/bookings-domain": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/karaoke-runtime": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "solid": {
      "entry": [
        "vite.config.ts",
        ".storybook/vite.config.ts",
        "src/entry-client.tsx",
        "src/entry-server.tsx",
        "src/middleware.ts",
        "src/design-system.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/**/*.stories.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        ".storybook/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts}",
        "src/**/*.{ts,tsx,js,jsx}"
      ],
      "ignoreDependencies": ["cloudflare"],
      "vite": false
    },
    "packages/solid-ui": {
      "entry": [
        "src/**/*.stories.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "scripts/**/*.{mjs,ts,tsx}"
      ],
      "project": [
        ".storybook/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts,tsx}",
        "src/**/*.{ts,tsx,js,jsx}"
      ],
      "vite": false
    }
  }
}
